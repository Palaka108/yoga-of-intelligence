# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://qwlbbcrjdpuxkavwyjyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner-only participant list at /admin/clients (private notes and signups).
# Leave unset to keep that page locked. Do not prefix with NEXT_PUBLIC_.
SESSION_OWNER_PASSWORD=

# ElevenLabs, server only. /join duplicates TEMPLATE_AGENT_ID for each new person.
# Never prefix the key with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
TEMPLATE_AGENT_ID=agent_2901m4hrxsemfj0thpsyxfqxr54f

# Optional. When set, /join asks for this code before creating a page.
JOIN_CODE=

# Upstash Redis from the Vercel Marketplace (Storage → Redis / Upstash).
# Required for new signups and for participant sign-in. Without these, voice
# pages stay locked (the locked page still renders). KV_REST_API_URL and
# KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Both are required to email password-reset links.
# Without them, create a one-time link from /admin/clients and send it yourself.
# RESEND_FROM_EMAIL must be a verified sender, for example
# "Yoga of Intelligence <hello@yogaofintelligence.com>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
